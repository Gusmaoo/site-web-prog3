# =====================================================================
# MODELO de configuração — este arquivo VAI para o GitHub.
# Copie para ".env" e preencha com os valores reais:  cp .env.example .env
# Nunca coloque senhas reais aqui.
# =====================================================================

# Servidor
PORT=3000
APP_URL=http://localhost:3000

# Banco de dados SQLite (caminho relativo à pasta do projeto)
DB_FILE=data/escola.sqlite

# Senha das contas de demonstração criadas pelo seed.
# Vazio = usa as senhas padrão do README. Só vale para contas ainda não criadas
# (rode "npm run reset" para recriar o banco com a nova senha).
DEMO_SENHA=

# SMTP — envio do e-mail de recuperação de senha.
# Vazio = modo demonstração (o link aparece no terminal).
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@dominio.com
SMTP_PASS=sua-senha-ou-app-password
SMTP_FROM=seu-email@dominio.com
